<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/header') %>

    <main style="display: flex; justify-content: center; padding: 3rem 1rem; background-color: #111;">
        <div style="background-color: #1a1a1a; padding: 2.5rem; border-radius: 8px; border: 1px solid #333; width: 100%; max-width: 600px;">
            
            <h2 style="color: white; margin-bottom: 1.5rem; text-align: center;">Editar: <%= producto.name %></h2>
            
            <!-- El action apunta a la ruta PUT para actualizar el producto específico -->
            <form action="/productos/editar/<%= producto.id %>?_method=PUT" method="POST" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 1rem;">
                
                <div>
                    <label style="color: #ccc; display: block; margin-bottom: 0.5rem;">Nombre del producto:</label>
                    <input type="text" name="name" value="<%= producto.name %>" style="width: 100%; padding: 0.8rem; background-color: #222; border: 1px solid #444; color: white; border-radius: 4px; box-sizing: border-box;" required>
                </div>

                <div>
                    <label style="color: #ccc; display: block; margin-bottom: 0.5rem;">Categoría:</label>
                    <select name="category" style="width: 100%; padding: 0.8rem; background-color: #222; border: 1px solid #444; color: white; border-radius: 4px; box-sizing: border-box;">
                        <option value="remera" <%= producto.category === 'remera' ? 'selected' : '' %>>Remera</option>
                        <option value="buzo" <%= producto.category === 'buzo' ? 'selected' : '' %>>Buzo</option>
                        <option value="accesorio" <%= producto.category === 'accesorio' ? 'selected' : '' %>>Accesorio</option>
                    </select>
                </div>

                <div>
                    <label style="color: #ccc; display: block; margin-bottom: 0.5rem;">Talles disponibles (separados por coma):</label>
                    <input type="text" name="sizes" value="<%= producto.talles ? producto.talles.join(', ') : '' %>" style="width: 100%; padding: 0.8rem; background-color: #222; border: 1px solid #444; color: white; border-radius: 4px; box-sizing: border-box;">
                </div>

                <div>
                    <label style="color: #ccc; display: block; margin-bottom: 0.5rem;">Precio ($):</label>
                    <input type="number" name="price" value="<%= producto.price %>" style="width: 100%; padding: 0.8rem; background-color: #222; border: 1px solid #444; color: white; border-radius: 4px; box-sizing: border-box;" required>
                </div>

                <div>
                    <label style="color: #ccc; display: block; margin-bottom: 0.5rem;">Imagen actual:</label>
                    <img src="/images/<%= producto.image %>" alt="Imagen actual" style="width: 100px; display: block; margin-bottom: 1rem; border-radius: 4px; border: 1px solid #444;">
                    
                    <label style="color: #ccc; display: block; margin-bottom: 0.5rem;">Subir nueva imagen (opcional):</label>
                    <input type="file" name="image" style="width: 100%; padding: 0.8rem; background-color: #222; border: 1px solid #444; color: white; border-radius: 4px; box-sizing: border-box;">
                </div>

                <div>
                    <label style="color: #ccc; display: block; margin-bottom: 0.5rem;">Descripción:</label>
                    <textarea name="description" rows="4" style="width: 100%; padding: 0.8rem; background-color: #222; border: 1px solid #444; color: white; border-radius: 4px; box-sizing: border-box; resize: none;" required><%= producto.description %></textarea>
                </div>

                <button type="submit" style="background-color: #cc0000; color: white; padding: 12px; border: none; cursor: pointer; font-weight: bold; margin-top: 1rem; text-transform: uppercase;">Guardar Cambios</button>
            </form>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>