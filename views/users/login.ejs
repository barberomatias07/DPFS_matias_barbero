<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/header') %>

    <main style="display: flex; justify-content: center; padding: 3rem 1rem; background-color: #111;">
        <!-- Contenedor forzado a color oscuro para tapar el parche blanco -->
        <div style="background-color: #1a1a1a; padding: 2.5rem; border-radius: 8px; border: 1px solid #333; width: 100%; max-width: 450px;">
            
            <!-- Iniciar Sesión -->
            <section style="margin-bottom: 2.5rem; text-align: center;">
                <h2 style="color: white; margin-bottom: 1.5rem;">Iniciar Sesión</h2>
                <!-- Le conecto el action al POST del login -->
                <form action="/usuarios/login" method="POST" style="display: flex; flex-direction: column; gap: 1rem; text-align: left;">
                    <div>
                        <label style="color: #ccc; display: block; margin-bottom: 0.5rem;">Correo electrónico:</label>
                        <input type="email" name="email" required placeholder="tu@email.com" style="width: 100%; padding: 0.8rem; background-color: #222; border: 1px solid #444; color: white; border-radius: 4px; box-sizing: border-box;">
                    </div>
                    <div>
                        <label style="color: #ccc; display: block; margin-bottom: 0.5rem;">Contraseña:</label>
                        <input type="password" name="password" required placeholder="********" style="width: 100%; padding: 0.8rem; background-color: #222; border: 1px solid #444; color: white; border-radius: 4px; box-sizing: border-box;">
                    </div>
                    
                    <!-- Checkbox de recordarme para cumplir con el Sprint -->
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem;">
                        <input type="checkbox" id="remember" name="remember">
                        <label for="remember" style="color: #ccc; font-size: 0.9rem;">Recordarme para la próxima</label>
                    </div>

                    <button type="submit" style="background-color: #cc0000; color: white; padding: 12px; border: none; cursor: pointer; font-weight: bold; margin-top: 1rem; text-transform: uppercase;">Ingresar</button>
                </form>
            </section>

            <hr style="border-color: #333; margin-bottom: 2.5rem;">

            <!-- Crear Cuenta -->
            <section style="text-align: center;">
                <h2 style="color: white; margin-bottom: 1.5rem;">Crear Cuenta</h2>
                <!-- Le conecto el action al POST del registro y el enctype para la foto -->
                <form action="/usuarios/registro" method="POST" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 1rem; text-align: left;">
                    <div>
                        <label style="color: #ccc; display: block; margin-bottom: 0.5rem;">Nombre completo:</label>
                        <input type="text" name="fullName" required placeholder="Juan Pérez" style="width: 100%; padding: 0.8rem; background-color: #222; border: 1px solid #444; color: white; border-radius: 4px; box-sizing: border-box;">
                    </div>
                    <div>
                        <label style="color: #ccc; display: block; margin-bottom: 0.5rem;">Correo electrónico:</label>
                        <input type="email" name="email" required placeholder="tu@email.com" style="width: 100%; padding: 0.8rem; background-color: #222; border: 1px solid #444; color: white; border-radius: 4px; box-sizing: border-box;">
                    </div>
                    <div>
                        <label style="color: #ccc; display: block; margin-bottom: 0.5rem;">Contraseña:</label>
                        <input type="password" name="password" required placeholder="********" style="width: 100%; padding: 0.8rem; background-color: #222; border: 1px solid #444; color: white; border-radius: 4px; box-sizing: border-box;">
                    </div>
                    <div>
                        <label style="color: #ccc; display: block; margin-bottom: 0.5rem;">Foto de perfil:</label>
                        <input type="file" name="avatar" accept="image/*" style="width: 100%; color: #ccc;">
                    </div>
                    <button type="submit" style="background-color: #333; color: white; padding: 12px; border: 1px solid #555; cursor: pointer; font-weight: bold; margin-top: 1rem; text-transform: uppercase;">Registrarse</button>
                </form>
            </section>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>