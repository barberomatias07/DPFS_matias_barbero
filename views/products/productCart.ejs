<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/header') %>

    <main style="display: flex; flex-direction: column; align-items: center; padding: 2rem;">
        <h2 style="color: white; margin-bottom: 2rem;">Tu Carrito</h2>
        
        <section style="background-color: #1a1a1a; padding: 2rem; border-radius: 5px; border: 1px solid #333; width: 100%; max-width: 600px; margin-bottom: 2rem;">
            <div style="display: flex; gap: 1rem; align-items: center;">
                <!-- Imagen del producto corregida -->
                <img src="/images/che.jpg.jpeg" alt="Remera Che" style="width: 80px; height: 80px; object-fit: cover;">
                
                <div style="flex-grow: 1;">
                    <h4 style="color: white; margin: 0 0 0.5rem 0;">Remera "Hasta la victoria siempre"</h4>
                    <p style="color: #ccc; margin: 0 0 0.5rem 0; font-size: 0.9rem;">Talle: L</p>
                    <p style="color: #cc0000; font-weight: bold; margin: 0;">$18.000</p>
                </div>
                <div>
                    <label style="color: white; margin-right: 0.5rem;">Cant:</label>
                    <input type="number" value="1" min="1" style="width: 50px; padding: 0.2rem; background: #222; color: white; border: 1px solid #444;">
                </div>
            </div>
        </section>

        <section style="background-color: #1a1a1a; padding: 2rem; border-radius: 5px; border: 1px solid #333; width: 100%; max-width: 600px; text-align: right;">
            <h3 style="color: white; margin-bottom: 1rem;">Resumen de compra</h3>
            <p style="color: white; font-size: 1.2rem; margin-bottom: 1.5rem;">Total: <strong>$18.000</strong></p>
            <button class="btn-ver" style="background-color: #cc0000; color: white; padding: 10px 20px; border: none; cursor: pointer; font-weight: bold;">FINALIZAR COMPRA</button>
        </section>
    </main>

  <%- include('../partials/footer') %>
</body>
</html>