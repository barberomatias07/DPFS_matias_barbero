<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/header') %>

    <main style="display: flex; justify-content: center; padding: 3rem 1rem;">
        <section style="background-color: #1a1a1a; padding: 3rem; border-radius: 8px; border: 1px solid #333; display: flex; gap: 3rem; max-width: 900px; width: 100%; flex-wrap: wrap;">
            
            <!-- Imagen dinámica del producto usando EJS -->
            <div style="flex: 1; min-width: 300px;">
                <img id="img-producto" src="/images/<%= producto.image %>" alt="<%= producto.name %>" style="width: 100%; height: auto; border-radius: 4px; object-fit: cover; border: 1px solid #444;">
            </div>

            <!-- Información dinámica del producto usando EJS -->
            <div style="flex: 1; min-width: 300px; display: flex; flex-direction: column; justify-content: center;">
                
                <h2 id="titulo-producto" style="color: white; margin-top: 0; margin-bottom: 1rem; font-size: 2rem;">
                    <%= producto.name %>
                </h2>
                
                <p style="color: #cc0000; font-size: 1.8rem; font-weight: bold; margin-bottom: 1.5rem;">
                    $<%= producto.price %>
                </p>
                
                <p id="descripcion-producto" style="color: #ccc; line-height: 1.6; margin-bottom: 2rem;">
                    <%= producto.description %>
                </p>

                <!-- Formulario POST para enviar el producto y el talle elegido al carrito -->
                <form action="/carrito/agregar/<%= producto.id %>" method="POST" style="margin: 0; display: flex; flex-direction: column;">
                    <div style="margin-bottom: 2rem;">
                        <label for="talle" style="color: white; margin-right: 1rem; font-weight: bold;">Talle:</label>
                        <select id="talle" name="talle" style="padding: 0.5rem; background-color: #222; color: white; border: 1px solid #444; border-radius: 4px;">
                            <% if (producto.talles && producto.talles.length > 0) { %>
                                <% producto.talles.forEach(talle => { %>
                                    <option value="<%= talle %>"><%= talle %></option>
                                <% }) %>
                            <% } else { %>
                                <option value="S">S</option>
                                <option value="M">M</option>
                                <option value="L">L</option>
                                <option value="XL">XL</option>
                                <option value="XXL">XXL</option>
                            <% } %>
                        </select>
                    </div>

                    <button type="submit" style="background-color: #cc0000; color: white; border: none; padding: 1rem; font-size: 1.1rem; font-weight: bold; cursor: pointer; border-radius: 4px; text-transform: uppercase; text-align: center; width: 100%;">
                        Agregar al carrito
                    </button>
                </form>

                <!-- ========================================== -->
                <!-- ACÁ ESTÁN LOS BOTONES DE ADMINISTRADOR     -->
                <!-- ========================================== -->
                <div style="margin-top: 1rem; display: flex; gap: 1rem;">
                    <!-- Botón Editar -->
                    <a href="/productos/editar/<%= producto.id %>" style="flex: 1; background-color: #eab308; color: #111; padding: 1rem; text-decoration: none; font-weight: bold; border-radius: 4px; text-transform: uppercase; text-align: center;">
                        ✏️ Editar
                    </a>

                    <!-- Botón Borrar (Formulario con method-override) -->
                    <form action="/productos/borrar/<%= producto.id %>?_method=DELETE" method="POST" style="flex: 1; margin: 0;">
                        <button type="submit" style="width: 100%; background-color: #7f1d1d; color: white; border: none; padding: 1rem; font-weight: bold; cursor: pointer; border-radius: 4px; text-transform: uppercase;">
                            🗑️ Borrar
                        </button>
                    </form>
                </div>
            </div>
        </section>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>